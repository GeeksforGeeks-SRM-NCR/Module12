{
  "name": "rural-dtn-module",
  "version": "0.1.0",
  "description": "Delay-Tolerant Networking (DTN) for rural region connectivity - store-and-forward messaging for intermittent networks",
  "main": "pkg/rural_dtn_module.js",
  "types": "pkg/rural_dtn_module.d.ts",
  "files": ["pkg"],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "build:nodejs": "wasm-pack build --target nodejs --out-dir pkg-node",
    "build:bundler": "wasm-pack build --target bundler --out-dir pkg-bundler",
    "test": "cargo test",
    "clean": "rimraf pkg pkg-node pkg-bundler target",
    "serve": "npx serve -p 3000"
  },
  "keywords": [
    "dtn",
    "delay-tolerant",
    "rural",
    "networking",
    "store-and-forward",
    "wasm",
    "webassembly",
    "rust"
  ],
  "author": "GFG Barnacle Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitcomit8/gfg-barnacle"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "serve": "^14.2.0",
    "wasm-pack": "^0.12.0"
  }
}
